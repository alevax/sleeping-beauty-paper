# === Fusion Finder Large Files ===
# Raw data
fusion_finder/data/

# Results - ignore BAMs, keep fusions
fusion_finder/results/

# Reference files - ignore large files, keep chrSB.fa
fusion_finder/reference/mm10*.fa
fusion_finder/reference/mm10*.fai
fusion_finder/reference/*.gtf
fusion_finder/reference/*.gff
fusion_finder/reference/hisat2_index/
!fusion_finder/reference/chrSB.fa

# Logs
fusion_finder/logs/

# === Isoform Switching Large Files ===
# All data and results (pre-computed upstream analysis)
isoform_switching/data/
isoform_switching/results/
isoform_switching/reference/

# Logs
isoform_switching/logs/
isoform_switching/*.log

